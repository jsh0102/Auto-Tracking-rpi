[Unit]
Description=RTSP person-tracking pan/tilt camera
After=network-online.target mediamtx.service
Wants=network-online.target
Requires=mediamtx.service
# 기본 백엔드(kservo)는 커널 모듈을 쓴다 — /etc/modules-load.d 로 부팅 시 적재한다.
# motor.backend=servo 로 바꾸면 pigpiod.service 를 After/Requires 에 추가한다.

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/build/camtracker --config __ROOT__/config.json
Restart=on-failure
RestartSec=5
# 서보가 중립으로 돌아갈 시간을 준다
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
