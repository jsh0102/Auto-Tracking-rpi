{
  "camera": {
    "width": 1280,
    "height": 720,
    "fps": 30,
    "bitrate": 3000000
  },
  "stream": {
    "rtsp_url": "rtsp://127.0.0.1:8554/cam"
  },
  "detect": {
    "backend": "ssd",
    "confidence": 0.5,
    "interval": 1,
    "tracker": "kcf"
  },
  "motor": {
    "backend": "kservo",
    "pan_pin": 12,
    "tilt_pin": 13,
    "pan_invert": true,
    "tilt_invert": true,
    "min_pulse_ms": 0.5,
    "max_pulse_ms": 2.5,
    "pan_min": -90.0,
    "pan_max": 90.0,
    "tilt_min": -90.0,
    "tilt_max": 90.0
  },
  "track": {
    "enabled": true,
    "deadzone": 0.12
  },
  "debug": {
    "log_level": "INFO",
    "snapshot_path": ""
  }
}
